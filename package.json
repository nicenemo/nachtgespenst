{
  "name": "nachtgespenst-site",
  "version": "0.0.0",
  "private": true,
  "description": "The project site of Nachtgespenst: sources, checks, tests and the build that minifies it",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"*.css\"",
    "lint:html": "html-validate \"*.html\"",
    "types": "tsc",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run types",
    "test": "node --test test/",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm test && npm run build",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.10",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "html-minifier-terser": "7.2.0",
    "html-validate": "11.22.1",
    "jsdom": "31.0.1",
    "stylelint": "18.1.0",
    "stylelint-config-standard": "41.1.0",
    "typescript": "7.0.2"
  }
}
